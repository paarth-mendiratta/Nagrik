# Server
PORT=8080
NODE_ENV=development

# Set this at deploy time — production refuses to boot without it.
# Comma-separate multiple origins if needed.
CLIENT_URL=

# Supabase — project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
# - latentstack.dev (LatentCode, OpenAI-compatible): PRIMARY classify
#   provider (gemini-3.7-flash, vision-verified; ~$20/day spend cap
#   separate from rate limits — on 402 budget_exceeded switch providers).
#   LATENTCODE_API_KEY required.
# - agentrouter.org (Anthropic-compatible): complaint letters (glm-5.3)
#   and the classify FALLBACK (gpt-5.6-sol, vision-verified). Set
#   CLASSIFY_PROVIDER=agentrouter only if latentstack is down.
LATENTCODE_API_KEY=
AGENTROUTER_API_KEY=
CLASSIFY_PROVIDER=latentcode

# Instagram (Meta Graph API) — see server/lib/instagram.js for setup steps.
# Leave IG_SIMULATE=true until you've done the Meta app review; the app
# will log/mock posts instead so you can still demo the feature.
IG_SIMULATE=true
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
IG_REPOST_AFTER_DAYS=3
IG_ESCALATION_DAYS=7
