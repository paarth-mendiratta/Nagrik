# Server
PORT=8080
NODE_ENV=development

# Set this at deploy time — production refuses to boot without it.
# Comma-separate multiple origins if needed.
CLIENT_URL=

# Supabase — project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude-compatible AI via agentrouter.org (photo classification + complaint drafting)
AGENTROUTER_API_KEY=

# Instagram (Meta Graph API) — see server/lib/instagram.js for setup steps.
# Leave IG_SIMULATE=true until you've done the Meta app review; the app
# will log/mock posts instead so you can still demo the feature.
IG_SIMULATE=true
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
IG_REPOST_AFTER_DAYS=3
IG_ESCALATION_DAYS=7
