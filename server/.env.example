# Server
PORT=8080
NODE_ENV=development

# Set this at deploy time — production refuses to boot without it.
# Comma-separate multiple origins if needed.
CLIENT_URL=

# Supabase — project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
# - agentrouter.org (Anthropic-compatible): complaint letters (glm-5.3)
#   and the DEFAULT classify provider (gpt-5.6-sol, vision-verified).
# - latentstack.dev (LatentCode, OpenAI-compatible): classify FALLBACK
#   provider (gemini-3.1-pro, vision-verified). Set CLASSIFY_PROVIDER=
#   latentcode when the agentrouter budget pool is exhausted (402s).
AGENTROUTER_API_KEY=
LATENTCODE_API_KEY=
CLASSIFY_PROVIDER=agentrouter

# Instagram (Meta Graph API) — see server/lib/instagram.js for setup steps.
# Leave IG_SIMULATE=true until you've done the Meta app review; the app
# will log/mock posts instead so you can still demo the feature.
IG_SIMULATE=true
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
IG_REPOST_AFTER_DAYS=3
IG_ESCALATION_DAYS=7
